# .env.example - Configuration for NotebookLM Gateway

# Gateway Host & Port
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Admin Authentication Token (used in X-Admin-Token header)
ADMIN_TOKEN=your-random-admin-secret-key

# Redis (optional, defaults to local redis if present)
REDIS_URL=redis://localhost:6379/0

# File Storage Paths
TOKEN_DIR=./storage/tokens
DB_PATH=./storage/db/gateway.db

# Rate Limiting (Requests Per Minute per API key)
RATE_LIMIT_DEFAULT=60

# Logging
LOG_LEVEL=INFO
